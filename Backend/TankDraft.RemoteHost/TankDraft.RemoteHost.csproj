<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><ContainerImageFormat>OCI</ContainerImageFormat><ContainerUser>1654</ContainerUser></PropertyGroup>
  <PropertyGroup><RemoteEntryMode Condition="'$(RemoteEntryMode)' == ''">--serve</RemoteEntryMode></PropertyGroup>
  <Target Name="ValidateRemoteEntryMode" BeforeTargets="Build"><Error Condition="'$(RemoteEntryMode)' != '--serve' And '$(RemoteEntryMode)' != '--edgegap-managed-tls'" Text="Unsupported remote entry mode." /></Target>
  <ItemGroup><ContainerAppCommand Include="dotnet" /><ContainerAppCommand Include="/app/TankDraft.RemoteHost.dll" /><ContainerAppCommandArgs Include="$(RemoteEntryMode)" /><ContainerPort Include="8080" Type="tcp" /></ItemGroup>
  <ItemGroup>
    <Content Update="Config/remote-host.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../TankDraft.Game.Core/TankDraft.Game.Core.csproj" />
    <ProjectReference Include="../TankDraft.Server.Match/TankDraft.Server.Match.csproj" />
    <ProjectReference Include="../TankDraft.Server.Security/TankDraft.Server.Security.csproj" />
    <ProjectReference Include="../TankDraft.Server.Admission/TankDraft.Server.Admission.csproj" />
    <ProjectReference Include="../TankDraft.Server.PlayFab.Identity/TankDraft.Server.PlayFab.Identity.csproj" />
    <ProjectReference Include="../TankDraft.Server.Meta/TankDraft.Server.Meta.csproj" />
    <ProjectReference Include="../TankDraft.Server.Settlement/TankDraft.Server.Settlement.csproj" />
    <ProjectReference Include="../TankDraft.Server.Progression/TankDraft.Server.Progression.csproj" />
    <Content Include="../Content/local-match.json" Link="Content/local-match.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Content/local-match.sha256" Link="Content/local-match.sha256" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Content/meta-rules.json" Link="Content/meta-rules.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Content/meta-rules.sha256" Link="Content/meta-rules.sha256" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Content/progression-rules.json" Link="Content/progression-rules.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Content/progression-rules.sha256" Link="Content/progression-rules.sha256" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
