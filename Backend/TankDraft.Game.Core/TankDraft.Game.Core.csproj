<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TankDraft.Game.Core</AssemblyName>
    <RootNamespace>TankDraft</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/TankDraft/Runtime/Shared/Contracts/**/*.cs"
             Link="Shared/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/TankDraft/Runtime/Match/Domain/*.cs"
             Link="Match/Domain/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/TankDraft/Runtime/Battle/Simulation/*.cs"
             Link="Battle/Simulation/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/TankDraft/Runtime/Match/Networking/Core/*.cs"
             Link="Match/Networking/Core/%(Filename)%(Extension)" />
    <Compile Include="../ThirdParty/LeoEcsLite/src/*.cs"
             Link="ThirdParty/LeoEcsLite/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
