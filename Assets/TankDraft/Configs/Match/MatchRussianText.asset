  _noArmy: "\u0410\u0440\u043C\u0438\u044F \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u0430"
  _unsupportedDeck: "\u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0430
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043C\u0438\u043D\u044B, \u0442\u044F\u0436\u0451\u043B\u044B\u0439
    \u0442\u0430\u043D\u043A, \u041F\u0422-\u0421\u0410\u0423 \u0438 \u043F\u043E\u043B\u0435\u0432\u0443\u044E
    \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u044E. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438\u043A\u0430\u0437 \xAB\u0423\u0441\u0438\u043B\u0438\u0442\u044C
    \u0431\u0440\u043E\u043D\u044E\xBB; \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043B\u043E\u0442\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432
    \u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0443\u0441\u0442\u044B\u043C\u0438."
  _orderHint: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0434\u043D\u0443
    \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443. \u041F\u0440\u0438\u043A\u0430\u0437
    \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u0442\u0435\u043A\u0443\u0449\u0438\u0439
    \u0432\u044B\u0431\u043E\u0440."
